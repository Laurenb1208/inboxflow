# --- Required secrets ---
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI:
#   Dev:  https://<your-replit-dev-domain>/api/auth/google/callback
#   Prod: https://<your-app>.replit.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: explicit override; if unset the app derives it from the request host.
# GOOGLE_REDIRECT_URI=https://yourapp/api/auth/google/callback

# Long random string used to sign session cookies.
SESSION_SECRET=

# 32 raw bytes, base64-encoded. Used to AES-GCM encrypt Gmail refresh tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Provided automatically by Replit Postgres ---
DATABASE_URL=

# --- Social / OG meta tags ---
# Set to your production origin (no trailing slash) so og:image URLs are absolute.
# Example: https://inboxflow.azurewebsites.net
# Leave blank during local development (image path will be relative).
VITE_APP_URL=
